# Copie para .env.local (local) ou defina no alojamento (produção).

# Endereço público do site (links canónicos, sitemap, imagem de partilha e links enviados por WhatsApp).
SITE_URL=https://www.henprotrust.pt

# Base de dados. Sem estas variáveis é usado o ficheiro local data/henprotrust.db.
# Para alojamento sem disco permanente (ex.: Vercel), crie uma base Turso (libSQL) e preencha
# (a integração Turso da Vercel cria TURSO_DATABASE_URL e TURSO_AUTH_TOKEN, que também funcionam):
# DATABASE_URL=libsql://nome-da-base.turso.io
# DATABASE_AUTH_TOKEN=...
